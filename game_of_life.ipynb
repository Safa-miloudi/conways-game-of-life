# ---------------------------------------------------------
# STEP 1: IMPORTS & CLASS DEFINITION
# ---------------------------------------------------------
import matplotlib.pyplot as plt
import time
from IPython.display import clear_output

class GameOfLife:
    """
    Implements Conway's Game of Life.
    
    Rules:
    1. Underpopulation: A live cell with < 2 neighbors dies.
    2. Survival: A live cell with 2 or 3 neighbors lives.
    3. Overpopulation: A live cell with > 3 neighbors dies.
    4. Reproduction: A dead cell with exactly 3 neighbors becomes a live cell.
    """

    def __init__(self, x_dim, y_dim):
        """
        Initializes the grid with dimensions x_dim by y_dim, filled with dead cells (0).
        """
        self.x_dim = x_dim
        self.y_dim = y_dim
        self.life_grid = [[0 for _ in range(y_dim)] for _ in range(x_dim)]

    def populate_grid(self, coordinates):
        """
        Populates the grid with live cells at the specified (x, y) coordinates.
        
        Args:
            coordinates (list of tuples): List of (row, col) positions to activate.
        """
        for row, col in coordinates:
            if 0 <= row < self.x_dim and 0 <= col < self.y_dim:
                self.life_grid[row][col] = 1
        return self.life_grid

    def _get_neighbor_sum(self, row, col):
        """
        Calculates the sum of alive neighbors for a specific cell.
        """
        neighbor_sum = 0
        for i in range(max(0, row - 1), min(self.x_dim, row + 2)):
            for j in range(max(0, col - 1), min(self.y_dim, col + 2)):
                if (i, j) != (row, col):  # Exclude the cell itself
                    neighbor_sum += self.life_grid[i][j]
        return neighbor_sum

    def make_step(self):
        """
        Evolves the grid by one generation based on Game of Life rules.
        """
        # Create a new grid to store next state (avoid modifying current grid while reading)
        new_grid = [[0 for _ in range(self.y_dim)] for _ in range(self.x_dim)]
        
        for row in range(self.x_dim):
            for col in range(self.y_dim):
                neighbors = self._get_neighbor_sum(row, col)
                current_state = self.life_grid[row][col]
                
                # Apply Rules
                if current_state == 1:
                    if neighbors < 2 or neighbors > 3:
                        new_grid[row][col] = 0  # Dies (Under/Overpopulation)
                    else:
                        new_grid[row][col] = 1  # Survives
                else:
                    if neighbors == 3:
                        new_grid[row][col] = 1  # Reproduction
        
        self.life_grid = new_grid
        return self.life_grid

    def make_n_steps(self, n):
        """
        Advances the game by n steps.
        """
        for _ in range(n):
            self.make_step()
        return self.life_grid

    def draw_grid(self):
        """
        Visualizes the current grid state using Matplotlib.
        """
        x_coords = []
        y_coords = []
        
        for col in range(self.y_dim):
            for row in range(self.x_dim):
                x_coords.append(col)
                y_coords.append(row)
        
        plt.figure(figsize=(6, 6))
        
        # We flatten the grid to map colors correctly to the scatter plot
        # Note: We need to align the list structure with the x/y generation order above
        flat_grid = [self.life_grid[row][col] for col in range(self.y_dim) for row in range(self.x_dim)]

        plt.scatter(x_coords, y_coords, s=150, c=flat_grid, cmap='Greys', edgecolors='black', marker='s')
        
        plt.xlim(-1, self.y_dim)
        plt.ylim(-1, self.x_dim)
        plt.gca().invert_yaxis() # Invert Y to match matrix coordinates (0,0 at top left)
        plt.axis('off') # Hide axis numbers for cleaner look
        plt.show()

# ---------------------------------------------------------
# STEP 2: DEMONSTRATION
# ---------------------------------------------------------

# 1. Initialize Game
game = GameOfLife(10, 10)

# 2. Populate with a "Glider" pattern
# A Glider is a pattern that travels across the grid
glider_coords = [(1, 2), (2, 3), (3, 1), (3, 2), (3, 3)]
game.populate_grid(glider_coords)

print("Initial State (Generation 0):")
game.draw_grid()

# 3. Simulate and Animate 5 generations
for i in range(1, 6):
    time.sleep(1)            # Pause for 1 second
    clear_output(wait=True)  # Clear previous plot
    game.make_step()
    print(f"Generation {i}:")
    game.draw_grid()